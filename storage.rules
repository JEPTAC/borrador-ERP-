rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function hasAuthEmail() { return signedIn() && request.auth.token.email is string && request.auth.token.email.size() > 0; }
    function uidUserPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function emailUserPath() { return /databases/(default)/documents/users/$(request.auth.token.email); }
    function uidUserExists() { return signedIn() && firestore.exists(uidUserPath()); }
    function emailUserExists() { return hasAuthEmail() && firestore.exists(emailUserPath()); }
    function userExists() { return uidUserExists() || emailUserExists(); }
    function userData() { return uidUserExists() ? firestore.get(uidUserPath()).data : firestore.get(emailUserPath()).data; }
    function activeUser() { return userExists() && userData().get('isActive', true) == true; }
    function role() { return activeUser() ? userData().role : ''; }
    function creatorRole() { return activeUser() && role() in ['super_admin','super_administrador','admin','administrador','ventas','asesor_ventas','asesor','comercial','ejecutivo_comercial']; }
    function reviewer() { return activeUser() && role() in ['super_admin','super_administrador','admin','administrador','cartera','jefe_cartera','analista_cartera','credito','creditos','analista_credito','coordinador_cartera']; }
    function viewer() { return activeUser() && (reviewer() || role() in ['gerencia','gerente','manager','auditoria','auditor']); }
    function requestPath(requestId) { return /databases/(default)/documents/credit_requests/$(requestId); }
    function requestExists(requestId) { return firestore.exists(requestPath(requestId)); }
    function requestData(requestId) { return firestore.get(requestPath(requestId)).data; }
    function validDocId(docId) { return docId in ['doc_01','doc_02','doc_03','doc_04','doc_05','doc_06','doc_07','doc_08','doc_09','doc_10','doc_11','doc_12','doc_13','doc_14','doc_15']; }
    function validFile() { return request.resource.size <= 15 * 1024 * 1024 && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)'); }
    match /credit_requests/{tenantId}/{requestId}/{docId}/{fileName} {
      allow read: if activeUser() && requestExists(requestId) && (requestData(requestId).createdBy == request.auth.uid || viewer());
      allow create, update: if activeUser() && validDocId(docId) && requestExists(requestId) && validFile()
        && request.resource.metadata.requestId == requestId
        && request.resource.metadata.docId == docId
        && request.resource.metadata.tenantId == tenantId
        && request.resource.metadata.ownerUid == requestData(requestId).createdBy
        && creatorRole()
        && requestData(requestId).createdBy == request.auth.uid
        && requestData(requestId).status in ['DRAFT','RETURNED'];
      allow delete: if activeUser() && creatorRole() && requestExists(requestId)
        && requestData(requestId).createdBy == request.auth.uid
        && requestData(requestId).status in ['DRAFT','RETURNED'];
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
